{
  "manifest_version": 1,
  "name": "A_model_router",
  "version": "0.1.0",
  "description": "一款通过插件运行时补丁，实现聊天会话级的细粒度函数-模型路由，支持特定群聊/私聊使用指定模型",
  "author": {
    "name": "A_Dawn",
    "url": "https://github.com/A-Dawn"
  },
  "license": "AGPL-3.0",
  "homepage_url": "https://github.com/A-Dawn/A_model_router/",
  "repository_url": "https://github.com/A-Dawn/A_model_router/",
  "host_application": {
    "min_version": "0.12.1",
    "max_version": "0.12.2"
  },
  "keywords": [
    "model-router",
    "llm-routing",
    "chat-groups",
    "ordered-fallback",
    "群聊",
    "私聊",
    "模型",
    "路由",
    "配置"
  ],
  "categories": [
    "Utility Tools"
  ],
  "plugin_info": {
    "is_built_in": false,
    "plugin_type": "general",
    "components": [
      {
        "type": "event_handler",
        "name": "a_model_router_start_handler",
        "description": "启动时安装 A_model_router 运行时补丁"
      },
      {
        "type": "event_handler",
        "name": "a_model_router_stop_handler",
        "description": "停止时卸载 A_model_router 运行时补丁"
      },
      {
        "type": "command",
        "name": "model_router",
        "description": "查看模型路由状态与规则"
      }
    ]
  },
  "id": "A_Dawn.A_model_router"
}
